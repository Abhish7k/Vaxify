# Local: Vite proxies /api, so this can be left unset.
# Production (Vercel): point at the Render API so cold-start pings
# are not cut off by the Vercel rewrite timeout.
# VITE_API_BASE_URL=https://api.vaxify.xyz/api

# Show the one-click demo login on the login page (for live demos).
# VITE_ENABLE_DEMO_LOGIN=true

# Copilot deployment mode. See docs/copilot-demo-mode.md.
# live = real RAG ask API. demo = pre-written examples, no RAG service.
# Omitted: production builds default to demo; local dev defaults to live.
# VITE_COPILOT_MODE=live
