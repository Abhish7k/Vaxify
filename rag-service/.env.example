# Google Gemini (embeddings only)
GOOGLE_API_KEY=

# Groq (answer generation)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=vaxify-kb-v1

# Embedding configuration (must match Pinecone index dimension)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
# Free-tier pace: Gemini counts embed_content units (~per text) at 100/min.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_PER_MINUTE=80
EMBEDDING_MAX_RETRIES=10
EMBEDDING_RETRY_DEFAULT_SECONDS=60
EMBEDDING_RETRY_MAX_SECONDS=120

# Ingestion
INGESTION_VERSION=1.0.0
KNOWLEDGE_BASE_PATH=./knowledge-base
DATA_PATH=./data

# Runtime
LOG_LEVEL=INFO
PORT=8001
# Shared secret required on POST /ask (header: X-RAG-Internal-Key)
RAG_INTERNAL_KEY=change-me-rag-internal-key

# Phase 2A retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_TIE_EPSILON=0.02

# Phase 2B grounded generation (Groq / Qwen)
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_OUTPUT_TOKENS=1024
GENERATION_TIMEOUT_SECONDS=60
GENERATION_MAX_RETRIES=5
GENERATION_MAX_CONTEXT_CHUNKS=5
ANSWERABILITY_MIN_TOP_SCORE=0.55
ANSWERABILITY_STRONG_TOP_SCORE=0.70
ANSWERABILITY_MIN_TERM_OVERLAP=0.4
