# data (Aiven MySQL)
DB_HOST=hostname
DB_PORT=22110
DB_NAME=vaxify
DB_USERNAME=avnadmin
DB_PASSWORD=password
DB_SSL=true
DB_REQUIRE_SSL=true
DB_VERIFY_CERT=false


# jwt
JWT_SECRET=your_super_secret_key_change_me_to_something_very_long
JWT_EXPIRATION=86400000


# cors
ALLOWED_ORIGINS=https://vaxify.xyz,https://www.vaxify.xyz


# aws s3
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=vaxify-docs-bucket


# email — Brevo SMTP
# local / paid hosts: MAIL_PORT=587
# Render free blocks 25/465/587 — use 2525 there
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_AUTH=true
MAIL_TLS=true
MAIL_FROM_ADDRESS=no-reply@vaxify.xyz
MAIL_FROM_NAME=Vaxify Team


# app config
FRONTEND_URL=https://vaxify.xyz
BACKEND_URL=http://localhost:8080
